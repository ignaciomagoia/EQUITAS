# Entorno exclusivo para Supabase local. No usar URL ni claves de produccion.
# Copiar como back/local-supabase.env y reemplazar SERVICE_ROLE_KEY con el valor
# que informa `supabase status -o env` despues de iniciar Docker local.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=LOCAL_SERVICE_ROLE_KEY
LAFALDA_IMPORT_TENANT_ID=1
LAFALDA_IMPORT_APPLY_ENABLED=false

# Solo habilitar temporalmente al ejecutar la prueba pytest local de apply.
# La prueba rechaza cualquier host que no sea localhost o 127.0.0.1.
EQUITAS_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
EQUITAS_LOCAL_SUPABASE_SERVICE_ROLE_KEY=LOCAL_SERVICE_ROLE_KEY
EQUITAS_RUN_LOCAL_APPLY_TESTS=false
