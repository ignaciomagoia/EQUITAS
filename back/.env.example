# Worker de importacion CSV de La Falda.
# Copiar como back/.env y cargar solamente credenciales de servidor.
# URL base del proyecto; no usar el endpoint /rest/v1.
SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
LAFALDA_IMPORT_TENANT_ID=1
LAFALDA_IMPORT_APPLY_ENABLED=false

# Worker exclusivo de la plataforma Multiinstitución. Estas credenciales no se
# comparten con La Falda y nunca se exponen al navegador.
MULTI_SUPABASE_URL=https://TU-MULTI-PROJECT-REF.supabase.co
MULTI_SUPABASE_PROJECT_REF=TU-MULTI-PROJECT-REF
MULTI_SUPABASE_SERVICE_ROLE_KEY=
MULTI_IMPORT_APPLY_ENABLED=false
