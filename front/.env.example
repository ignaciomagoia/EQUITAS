NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor: nunca usar prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ImportaciÃ³n diaria de La Falda. Usar solamente el ID del tenant validado.
# No completar con 1 hasta confirmar que dicho tenant sea La Falda.
LAFALDA_IMPORT_TENANT_ID=
# Mantener en false durante pruebas. Requiere autorizacion expresa para permitir escrituras.
LAFALDA_IMPORT_APPLY_ENABLED=false

# Disparo del worker alojado en GitHub Actions. Todas son solo de servidor.
# El token debe ser fine-grained, limitado a este repositorio y con Actions: write.
GITHUB_IMPORT_DISPATCH_TOKEN=
GITHUB_IMPORT_REPOSITORY=
GITHUB_IMPORT_WORKFLOW_FILE=lafalda-csv-import.yml
GITHUB_IMPORT_WORKFLOW_REF=main
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Equitas_prueba_bot
TELEGRAM_WEBHOOK_SECRET=
