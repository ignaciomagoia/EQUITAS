NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor: nunca usar prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Base independiente de la plataforma Multiinstitucion. Mantener todas las
# claves privadas sin prefijo NEXT_PUBLIC_. Nunca reutilizar las de La Falda.
NEXT_PUBLIC_MULTI_SUPABASE_URL=
NEXT_PUBLIC_MULTI_SUPABASE_PUBLISHABLE_KEY=
MULTI_SUPABASE_SERVICE_ROLE_KEY=

# ImportaciÃ³n diaria de La Falda. Usar solamente el ID del tenant validado.
# No completar con 1 hasta confirmar que dicho tenant sea La Falda.
LAFALDA_IMPORT_TENANT_ID=
# Mantener en false durante pruebas. Requiere autorizacion expresa para permitir escrituras.
LAFALDA_IMPORT_APPLY_ENABLED=false

# Disparo del worker alojado en GitHub Actions. Todas son solo de servidor.
# El token debe ser fine-grained, limitado a este repositorio y con Actions: write.
GITHUB_IMPORT_DISPATCH_TOKEN=
GITHUB_IMPORT_REPOSITORY=
GITHUB_IMPORT_WORKFLOW_FILE=lafalda-csv-import.yml
GITHUB_IMPORT_WORKFLOW_REF=main

# Worker de importaciones de la plataforma Multiinstitucion. Todas son solo
# variables de servidor; el navegador nunca recibe el token ni la service role.
MULTI_IMPORT_APPLY_ENABLED=false
GITHUB_MULTI_IMPORT_DISPATCH_TOKEN=
GITHUB_MULTI_IMPORT_REPOSITORY=
GITHUB_MULTI_IMPORT_WORKFLOW_FILE=multiinstitution-csv-import.yml
GITHUB_MULTI_IMPORT_WORKFLOW_REF=main
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Equitas_prueba_bot
TELEGRAM_WEBHOOK_SECRET=
